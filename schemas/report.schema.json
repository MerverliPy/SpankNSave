{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MerverliPy/SpankNSave/main/schemas/report.schema.json",
  "title": "SpankNSave analysis report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "plugin", "measurementPolicy", "summary", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "mode"],
      "properties": {
        "name": { "const": "SpankNSave" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
        "mode": { "enum": ["observe", "suggest", "enforce"] }
      }
    },
    "measurementPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritative", "estimated", "rawContentPersisted", "privacy"],
      "properties": {
        "authoritative": {
          "type": "array",
          "items": { "type": "string" }
        },
        "estimated": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rawContentPersisted": { "const": false },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["perMessageIdentifiers", "toolArgHashes", "rawPrompts"],
          "properties": {
            "perMessageIdentifiers": { "const": "never-persisted" },
            "toolArgHashes": { "const": "never-persisted" },
            "rawPrompts": { "const": "never-persisted" }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionID", "latestContextTokens", "cumulative", "estimated", "toolCalls", "retries", "compactions", "filesChanged"],
      "properties": {
        "sessionID": { "type": "string", "minLength": 1 },
        "contextLimit": { "type": "integer", "minimum": 1 },
        "latestContextTokens": { "type": "integer", "minimum": 0 },
        "contextPercent": { "type": "integer", "minimum": 0 },
        "cumulative": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output", "reasoning", "cacheRead", "cacheWrite", "cost"],
          "properties": {
            "input": { "type": "number", "minimum": 0 },
            "output": { "type": "number", "minimum": 0 },
            "reasoning": { "type": "number", "minimum": 0 },
            "cacheRead": { "type": "number", "minimum": 0 },
            "cacheWrite": { "type": "number", "minimum": 0 },
            "cost": { "type": "number", "minimum": 0 }
          }
        },
        "estimated": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latestTextPromptTokens", "systemTokens", "enabledToolSchemaTokens"],
          "properties": {
            "latestTextPromptTokens": { "type": "integer", "minimum": 0 },
            "systemTokens": { "type": "integer", "minimum": 0 },
            "enabledToolSchemaTokens": { "type": "integer", "minimum": 0 }
          }
        },
        "toolCalls": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "compactions": { "type": "integer", "minimum": 0 },
        "filesChanged": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "cause", "confidence", "evidence", "recommendation", "priorityScore"],
        "properties": {
          "severity": { "enum": ["info", "warning", "critical"] },
          "code": {
            "type": "string",
            "enum": [
              "CONTEXT_PRESSURE",
              "RAPID_CONTEXT_GROWTH",
              "OVERSIZED_USER_PROMPT",
              "OVERSIZED_SYSTEM_CONTEXT",
              "TOOL_SCHEMA_BLOAT",
              "OVERSIZED_TOOL_OUTPUT",
              "DUPLICATE_TOOL_CALLS",
              "HIGH_REASONING_SHARE",
              "EXCESSIVE_ASSISTANT_OUTPUT",
              "RETRY_WASTE"
            ]
          },
          "cause": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["low", "medium", "high"] },
          "evidence": { "type": "object" },
          "estimatedSavingsTokens": { "type": "integer", "minimum": 0 },
          "recommendation": { "type": "string", "minLength": 1 },
          "proposedPatch": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "target", "summary", "change", "risk", "autoApplicable"],
            "properties": {
              "kind": { "enum": ["configuration", "prompt", "tooling", "workflow", "compaction"] },
              "target": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "change": { "type": "string", "minLength": 1 },
              "risk": { "enum": ["low", "medium", "high"] },
              "autoApplicable": { "type": "boolean" }
            }
          },
          "priorityScore": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
